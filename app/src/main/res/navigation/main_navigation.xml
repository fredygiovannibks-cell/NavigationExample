<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="id.ac.polbeng.depandienda.navigationexample.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_categoryFragment"
            app:destination="@id/categoryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileActivity"
            app:destination="@id/profileActivity" />
    </fragment>

    <fragment
        android:id="@+id/categoryFragment"
        android:name="id.ac.polbeng.depandienda.navigationexample.CategoryFragment"
        android:label="fragment_category"
        tools:layout="@layout/fragment_category">
        <action
            android:id="@+id/action_categoryFragment_to_detailCategoryFragment"
            app:destination="@id/detailCategoryFragment" />
    </fragment>

    <activity
        android:id="@+id/profileActivity"
        android:name="id.ac.polbeng.depandienda.navigationexample.ProfileActivity"
        android:label="activity_profile"
        tools:layout="@layout/activity_profile" />

    <fragment
        android:id="@+id/detailCategoryFragment"
        android:name="id.ac.polbeng.depandienda.navigationexample.DetailCategoryFragment"
        android:label="fragment_detail_category"
        tools:layout="@layout/fragment_detail_category">

        <!-- Argumen name dan stock harus di dalam tag detailCategoryFragment ini -->
        <argument
            android:name="name"
            app:argType="string"
            android:defaultValue="default name" />

        <argument
            android:name="stock"
            app:argType="integer"
            android:defaultValue="0" />

        <action
            android:id="@+id/action_detailCategoryFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

    </fragment>

</navigation>